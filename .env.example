# --- Gemini ---
GOOGLE_API_KEY=sua_chave_aqui

# --- Autenticacao do webhook (segredo compartilhado com o bloco Vonix) ---
# Gere com: openssl rand -hex 32
VONIX_TOKEN=seu_token_aqui

# --- Google Calendar (OAuth refresh token, conta Gmail pessoal) ---
GOOGLE_OAUTH_CLIENT_ID=seu_client_id
GOOGLE_OAUTH_CLIENT_SECRET=seu_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=seu_refresh_token
GOOGLE_CALENDAR_ID=primary
TIMEZONE=America/Sao_Paulo

# --- Slack (Incoming Webhook, canal dedicado) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
